# SC1090/SC1091: le barrel charge les modules par chemin dynamique ($CHEZMOI_DIR/$_f.sh) —
# c'est le design (chargement modulaire), pas une erreur à corriger.
disable=SC1090
disable=SC1091

# SC2207: COMPREPLY=($(compgen -W "..." -- "$cur")) est l'idiome déjà utilisé par z.sh,
# repris tel quel pour completion.sh — mots statiques, pas de risque de glob/split.
disable=SC2207
